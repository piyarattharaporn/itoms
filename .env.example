# Copy to .env.local for local development. Values are placeholders only.
VITE_FIREBASE_API_KEY=replace-with-your-local-emulator-placeholder
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-lotus-it-portal-local
VITE_FIREBASE_APP_ID=replace-with-local-placeholder

# Set to true only when using the Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=true

# Optional overrides when default emulator ports are already occupied.
# VITE_AUTH_EMULATOR_PORT=19099
# VITE_FIRESTORE_EMULATOR_PORT=18080

# App Check is disabled in local development and Emulator mode.
# Enable only for an approved production Web App with a reCAPTCHA Enterprise site key.
VITE_ENABLE_APP_CHECK=false
# VITE_FIREBASE_APPCHECK_SITE_KEY=replace-with-recaptcha-enterprise-site-key

# Low-volume client instrumentation is disabled unless explicitly enabled.
VITE_ENABLE_USAGE_TELEMETRY=false

# The optional Phase 3–6 Trusted Backend is disabled by default.
# With false, the app uses the Spark-only Firestore Rules mutation path.
VITE_ENABLE_TRUSTED_BACKEND=false
# VITE_BACKEND_BASE_URL=http://127.0.0.1:8787
