# Copy to .env.production only after a Firebase project is approved and provisioned.
# Firebase web configuration is public client configuration, not a private credential.
VITE_FIREBASE_API_KEY=replace-with-approved-project-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-approved-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-approved-project-id
VITE_FIREBASE_APP_ID=replace-with-approved-project-app-id
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_APP_CHECK=true
VITE_FIREBASE_APPCHECK_SITE_KEY=replace-with-recaptcha-enterprise-site-key
# Spark-only mode: Ticket writes use the bounded Firestore Rules path.
VITE_ENABLE_TRUSTED_BACKEND=false
# Enable only after a separately approved HTTPS backend exists.
# VITE_BACKEND_BASE_URL=https://replace-with-approved-trusted-backend.example.com

# Keep client telemetry off until privacy, retention, and alert ownership are approved.
VITE_ENABLE_USAGE_TELEMETRY=false
