# UAT client configuration for itoms-uat. Public Firebase web config only.
VITE_APP_ENV=uat
VITE_FIREBASE_API_KEY=replace-with-itoms-uat-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=itoms-uat.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=itoms-uat
VITE_FIREBASE_APP_ID=replace-with-itoms-uat-web-app-id

VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_APP_CHECK=false
VITE_ENABLE_USAGE_TELEMETRY=false
VITE_ENABLE_TRUSTED_BACKEND=false
