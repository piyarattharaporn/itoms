    function canReadRca(propertyId) {
      return isSuperAdmin()
        || hasPropertyRole(propertyId, 'supportEngineer')
        || hasPropertyRole(propertyId, 'clientExecutive');
    }

    function validRca(record) {
      return record.keys().hasAll([
          'schemaVersion', 'propertyId', 'propertyCode', 'taskId', 'taskTitle', 'taskCategory',
          'taskPriority', 'taskCompletedAt', 'incidentSummary', 'rootCause', 'contributingFactors',
          'fiveWhys', 'impact', 'downtimeMinutes', 'correctiveAction', 'preventiveAction',
          'ownerUid', 'dueDate', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && record.keys().hasOnly([
          'schemaVersion', 'propertyId', 'propertyCode', 'taskId', 'taskTitle', 'taskCategory',
          'taskPriority', 'taskCompletedAt', 'incidentSummary', 'rootCause', 'contributingFactors',
          'fiveWhys', 'impact', 'downtimeMinutes', 'correctiveAction', 'preventiveAction',
          'ownerUid', 'dueDate', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && record.schemaVersion == 1
        && record.propertyId is string && record.propertyId.size() > 0 && record.propertyId.size() <= 160
        && record.propertyCode is string && record.propertyCode.size() > 0 && record.propertyCode.size() <= 40
        && canUseProperty(record.propertyId, record.propertyCode)
        && record.taskId is string && record.taskId.size() > 0 && record.taskId.size() <= 150
        && record.taskTitle is string && record.taskTitle.size() > 0 && record.taskTitle.size() <= 240
        && record.taskCategory is string && record.taskCategory.size() > 0 && record.taskCategory.size() <= 120
        && record.taskPriority in ['Low', 'Medium', 'High', 'Critical']
        && (record.taskCompletedAt == null || record.taskCompletedAt is timestamp)
        && record.incidentSummary is string && record.incidentSummary.size() <= 4000
        && record.rootCause is string && record.rootCause.size() <= 4000
        && record.contributingFactors is string && record.contributingFactors.size() <= 4000
        && record.fiveWhys is string && record.fiveWhys.size() <= 6000
        && record.impact is string && record.impact.size() <= 4000
        && (record.downtimeMinutes == null || (record.downtimeMinutes is int && record.downtimeMinutes >= 0 && record.downtimeMinutes <= 525600))
        && record.correctiveAction is string && record.correctiveAction.size() <= 4000
        && record.preventiveAction is string && record.preventiveAction.size() <= 4000
        && record.ownerUid is string && record.ownerUid.size() <= 128
        && validOptionalIsoDate(record.dueDate)
        && record.status in ['Draft', 'In Review', 'Approved', 'Closed']
        && record.createdBy is string && record.createdBy.size() > 0 && record.createdBy.size() <= 128
        && record.createdAt is timestamp
        && record.updatedAt is timestamp;
    }

    match /rcaRecords/{rcaId} {
      allow get, list: if canReadRca(resource.data.propertyId);
      allow create: if signedIn()
        && canManageProperty(request.resource.data.propertyId)
        && request.resource.data.status == 'Draft'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validRca(request.resource.data);
      allow update: if signedIn()
        && canManageProperty(resource.data.propertyId)
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.propertyCode == resource.data.propertyCode
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'incidentSummary', 'rootCause', 'contributingFactors', 'fiveWhys', 'impact',
          'downtimeMinutes', 'correctiveAction', 'preventiveAction', 'ownerUid', 'dueDate',
          'status', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && validRca(request.resource.data);
      allow delete: if false;
    }
